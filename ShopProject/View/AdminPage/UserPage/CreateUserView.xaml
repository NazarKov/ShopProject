<Window x:Class="ShopProject.View.AdminPage.UserPage.CreateUserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShopProject.ViewModel.AdminPage.UserPage"
        mc:Ignorable="d"
        Title="CreateUserView" Width="400" Height="520" ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/ButtonStyle.xaml"/>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/TextBoxStyle.xaml"/>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/TextBlockstyle.xaml"/>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/ComboBoxStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>  
    <Grid Height="520">
        <Grid VerticalAlignment="Center"  >

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/> 
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="1" Grid.Row="0" >
                <TextBlock x:Name="textBlock"
                           Visibility="{Binding ErrorTextBlockVisibiliti}"
                           Style="{StaticResource ErrorTextBlock}"
                           Grid.RowSpan="2" 
                           Text="{Binding Error}"  
                           Height="35"
                           Padding="8" />
                <TextBlock x:Name="textBlock1"
                           Visibility="{Binding SuccessTextBlockVisibiliti}"
                           Style="{StaticResource SuccessTextBlock}"
                           Grid.RowSpan="2" 
                           TextWrapping="Wrap"
                           Text="{Binding Success}"  
                           MinHeight="35"
                           Padding="8" />
            </StackPanel>

            <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,10,0,0" >

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"  Margin="5" >
                    <TextBlock Text="ПІБ:" Width="100" VerticalAlignment="Center" Foreground="#444"/>
                    <TextBox Width="200" Height="30"  Text="{Binding FullName}"  Padding="5" Style="{StaticResource GeneralTextBox}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5" >
                    <TextBlock Text="Логін:" Width="100" VerticalAlignment="Center" Foreground="#444"/>
                    <TextBox Width="200" Height="30" Text="{Binding Login}"  Padding="5"  Style="{StaticResource GeneralTextBox}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5" >
                    <TextBlock Text="Email:" Width="100" VerticalAlignment="Center" Foreground="#444"/>
                    <TextBox Width="200" Height="30" Text="{Binding Email}"  Padding="5"  Style="{StaticResource GeneralTextBox}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5"  >
                    <TextBlock Text="Пароль:" Width="100" VerticalAlignment="Center" Foreground="#444"/>
                    <TextBox Width="200" Height="30" Padding="5"  Style="{StaticResource GeneralTextBox}"
                             Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                    <TextBlock Text="Посада:" Width="100" VerticalAlignment="Center" Foreground="#444"/>
                    <ComboBox Width="200" Height="30"
                          ItemsSource="{Binding UserRoles}" SelectedIndex="{Binding SelectUserRole}"
                          DisplayMemberPath="NameRole" Style="{StaticResource GeneralComboBox}" />
                </StackPanel>
 
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5" >
                    <TextBlock Text="Ключ ЕЦП:" Width="100" VerticalAlignment="Center" Foreground="#444"/>
                    <Grid Width="200" Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                             Text="{Binding PathKey, UpdateSourceTrigger=PropertyChanged}"
                             Padding="5"  Style="{StaticResource GeneralTextBox}"/>
                        <Button Grid.Column="1"
                            Command="{Binding OpenFiLeKeyCommand}"
                            Background="CadetBlue"
                            BorderThickness="0" >
                            <Image Source="/Resource/Images/key.png" Width="16" Height="16"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5" >
                    <TextBlock Text="Пароль ЕЦП:" Width="100" VerticalAlignment="Center" Foreground="#444"/>
                    <TextBox Width="200" Height="30"
                             Padding="5"  Style="{StaticResource GeneralTextBox}"
                             Text="{Binding PasswordKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </StackPanel>
 
            <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,20,0,0"  >
                <Button Content="Створити" Height="35" Margin="5" Width="92" Command="{Binding CreateUserCommand}" Style="{StaticResource SuccessButton}"/>

                <Button Content="Очистити" Height="35" Margin="5"  Width="92" Command="{Binding ClearWindowCommadn}" Style="{StaticResource GeneralButton}"  />

                <Button Content="Вийти" Height="35" Margin="5"  Width="92" Command="{Binding ExitWindowCommand}" Style="{StaticResource ExitButton}" />
            </StackPanel>
        </Grid>
    </Grid>

</Window>
