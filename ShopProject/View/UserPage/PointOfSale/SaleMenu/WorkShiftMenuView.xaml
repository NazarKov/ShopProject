<Page x:Class="ShopProject.View.UserPage.PointOfSale.SaleMenu.WorkShiftMenuView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShopProject.View.UserPage.PointOfSale.SaleMenu"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:template="clr-namespace:ShopProject.Resource.template"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WorkShiftMenuView">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/ButtonStyle.xaml"/>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/TextBoxStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>  
    
    <Grid Name="Grid" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="110"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
        </Grid.RowDefinitions>
        <Rectangle x:Name="ShadowRect1" Visibility="{Binding VisibilitiShadowPage}" Fill="Black" Panel.ZIndex="2" Opacity="0.5" Grid.Column="0" Grid.Row="0" Grid.RowSpan="4" Grid.ColumnSpan="3"/>
        <Border Grid.Column="0"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="White"
                BorderBrush="#D9D9D9"
                BorderThickness="1"
                Margin="5"
                CornerRadius="6" 
                Padding="5">

            <StackPanel>

                <TextBlock Text="Меню керування"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="10"
                       Foreground="#333"/>

                <Separator Margin="5"/>
                <Button x:Name="button"  Content="Відкрити зміну" HorizontalAlignment="Stretch" Margin="10,10,10,10" 
                        Grid.RowSpan="2" Command="{Binding OpenOpenShiftDialogWindowCommand}"
                        Visibility="{Binding VisibilitiOpenShift}"
                        IsEnabled="{Binding IsEnableOpenShiftButton}"
                        Style="{StaticResource MenuButtonStyle}"
                        VerticalAlignment="Stretch"/>
                <Button x:Name="button1" Content="Новий чек" HorizontalAlignment="Stretch"  Margin="10,10,10,10" 
                        VerticalAlignment="Stretch"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding OpenNewCheck}"/>
                <Button x:Name="button7" Content="Друк останього чеку" HorizontalAlignment="Stretch" Margin="10,10,10,10" 
                        VerticalAlignment="Stretch" 
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding PrintLastCheckCommand}"/>
                <Button x:Name="button8" Content="Видати сертифікат" HorizontalAlignment="Stretch" Margin="10,10,10,10" 
                        VerticalAlignment="Stretch" 
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding PublishCertificateCommand}"/>
                <Button x:Name="button3" Content="Службове внесення" HorizontalAlignment="Stretch"  Margin="10,10,10,10"
                        VerticalAlignment="Stretch" 
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding OpenOfficialDepositMoneyDialogWindowCommad}"/>
                <Button x:Name="button4" Content="Службове видача" HorizontalAlignment="Stretch"  Margin="10,10,10,10" 
                        VerticalAlignment="Stretch" 
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding OpenOfficialWithdrawalMoneyDialogWindowCommad}"/>
                <Button x:Name="button5" Content="Закрити змінну" HorizontalAlignment="Stretch"  Margin="10,10,10,10"
                        Visibility="{Binding VisibilitiCloseShift}"
                        Command="{Binding OpenCloseShiftDialogWindowCommand}" 
                        Style="{StaticResource MenuButtonStyle}"
                        VerticalAlignment="Stretch"/>
                <Button x:Name="button6" Content="Назад до вибору каси" HorizontalAlignment="Stretch" Margin="10,10,10,10"
                        Visibility="{Binding VisibilitiExitButton}"
                        Style="{StaticResource MenuButtonStyle}"
                        IsEnabled="{Binding IsEnableCloseShiftButton}"
                        Command="{Binding ExitWorkShiftMenuCommand}"
                        VerticalAlignment="Stretch"></Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Top" 
                Margin="5"
                Padding="15"
                Height="100"
                CornerRadius="6"
                Background="#FAFAFA"
                BorderBrush="#D9D9D9"
                BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
 
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel> 
                        <TextBlock Text="Ваш ПРРО"
                           FontSize="24"
                           FontWeight="SemiBold"/> 
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Orientation="Horizontal">


                        <Border Margin="0,0,10,0"
                                VerticalAlignment="Center" 
                                Padding="10,4"
                                CornerRadius="6">

                            <StackPanel Orientation="Horizontal">

                                <Ellipse Width="10"
                                 Height="10"
                                 Margin="0,0,6,0"
                                 Fill="White"/>

                                <TextBlock Text="{Binding WorkingShiftStatus.StatusString}"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>

                            </StackPanel>

                            <Border.Style>

                                <Style TargetType="Border">

                                    <Setter Property="Background"
                                    Value="#6B7280"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding WorkingShiftStatus.Status}"
                                             Value="Open">
                                            <Setter Property="Background"
                                            Value="#22C55E"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding WorkingShiftStatus.Status}"
                                             Value="Close">
                                            <Setter Property="Background"
                                            Value="#EF4444"/>
                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Border.Style>

                        </Border> 
                        <Border Padding="10,4"
                                VerticalAlignment="Center" 
                                CornerRadius="6"
                                Background="#B91C1C">

                            <Border.Style>

                                <Style TargetType="Border"> 
                                    <Setter Property="Visibility"  Value="Collapsed"/> 
                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding WorkingShiftStatus.IsTestMode}" Value="True">
                                            <Setter Property="Visibility"  Value="Visible"/>
                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Border.Style>

                            <StackPanel Orientation="Horizontal">

                                <Ellipse Width="10"
                                         Height="10"
                                         Fill="White"
                                         Margin="0,0,6,0"/>

                                <TextBlock Text="Режим тестування"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>

                            </StackPanel>

                        </Border>
                    </StackPanel> 
                </Grid>
 
                <Border Grid.Row="1"
                        Margin="0,18"
                        Height="1"
                        Background="#E5E7EB"/>
 

                <UniformGrid Grid.Row="2"
                     Columns="4"> 
                    <StackPanel>

                        <TextBlock Text="Фіскальний номер"
                           FontSize="12"
                           Foreground="#808080"/>

                        <TextBlock Text="{Binding WorkingShiftStatus.OperationRecorder.FiscalNumber}"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                    </StackPanel>

                    <StackPanel>

                        <TextBlock Text="Господарський об'єкт"
                           FontSize="12"
                           Foreground="#808080"/>

                        <TextBlock Text="{Binding WorkingShiftStatus.TaxObject.NameObject}"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                    </StackPanel>

                    <StackPanel>

                        <TextBlock Text="Каса"
                           FontSize="12"
                           Foreground="#808080"/>

                        <TextBlock Text="{Binding WorkingShiftStatus.OperationRecorder.Name}"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                    </StackPanel>

                    <StackPanel>

                        <TextBlock Text="Онлайн з"
                           FontSize="12"
                           Foreground="#808080"/>

                        <TextBlock Text="{Binding WorkingShiftStatus.OpenShiftTime}"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                    </StackPanel>

                </UniformGrid>

            </Grid>

        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                Grid.RowSpan="2"
                Margin="5"
                CornerRadius="6"
                Padding="5"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1">

            <TabControl x:Name="tabControl"
                ItemsSource="{Binding Tabs}"
                SelectedIndex="{Binding SelectedTabItem}"
                Background="Transparent"
                BorderThickness="0"
                Padding="6">

                <TabControl.Resources>

                    <Style TargetType="TabItem">

                        <Setter Property="Template">

                            <Setter.Value>

                                <ControlTemplate TargetType="TabItem">

                                    <Border x:Name="TabBorder"
                                            Background="#E9ECEF"
                                            BorderBrush="#D9D9D9"
                                            CornerRadius="6"
                                            Margin="4,2"
                                            Padding="14,6"
                                            Cursor="Hand">

                                        <StackPanel Orientation="Horizontal">
 
                                            <Ellipse Width="8"
                                             Height="8"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center"
                                             Fill="#9CA3AF"/>
 
                                            <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                               FontSize="13"
                                               Foreground="#333"
                                               VerticalAlignment="Center"/>

                                        </StackPanel>

                                    </Border>

                                    <ControlTemplate.Triggers> 
                                        <Trigger Property="IsSelected" Value="True">

                                            <Setter TargetName="TabBorder"
                                                    Property="Background"
                                                    Value="White"/>

                                            <Setter TargetName="TabBorder"
                                                    Property="BorderBrush"
                                                    Value="CadetBlue"/>

                                            <Setter TargetName="TabBorder"
                                                    Property="BorderThickness"
                                                    Value="1"/>

                                            <Setter TargetName="TabBorder"
                                                    Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="10"
                                                              ShadowDepth="1"
                                                              Opacity="0.15"/>
                                                </Setter.Value>
                                            </Setter>

                                        </Trigger> 

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Setter.Value>

                        </Setter>

                    </Style>

                </TabControl.Resources>

            </TabControl>

        </Border>
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="10" Visibility="{Binding VisibilitiOpenShiftDialogWindow}" Panel.ZIndex="4">
            <Border Background="#FAFAFA"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    CornerRadius="8"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    Padding="20"
                    Width="520"> 
                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                     
                    <StackPanel Orientation="Horizontal">

                        <Border Width="42"
                                Height="42"
                                Background="#27AE60"
                                CornerRadius="21">

                            <TextBlock Text="🟢"
                                       FontSize="20"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="12,0,0,0">

                            <TextBlock Text="Відкриття зміни"
                                       FontSize="22"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Перевірте інформацію перед початком роботи."
                                       Foreground="Gray"/>
                        </StackPanel>

                    </StackPanel>
 
                    <Grid Grid.Row="2">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
 

                        <Border Grid.Row="0"
                                Background="White"
                                BorderBrush="#E5E5E5"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"> 
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Касир"
                                           Foreground="Gray"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding UserName}"
                                           FontWeight="SemiBold"/> 
                            </Grid>

                        </Border> 

                        <Border Grid.Row="2"
                                Background="White"
                                BorderBrush="#E5E5E5"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Точка"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding WorkingShiftStatus.TaxObject.NameObject}"
                                           FontWeight="SemiBold"/> 
                            </Grid> 
                        </Border> 

                        <Border Grid.Row="4"
                                Background="White"
                                BorderBrush="#E5E5E5"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Каса"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding WorkingShiftStatus.OperationRecorder.Name}"
                                           FontWeight="SemiBold"/>

                            </Grid>

                        </Border> 

                        <StackPanel Grid.Row="6">

                            <TextBlock Text="Початкова сума"
                                       Margin="0,0,0,8"
                                       FontWeight="SemiBold"/>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Height="42"
                                         FontSize="18"
                                         Padding="10,5"
                                         Text="{Binding Cash}"/>

                                <Border Grid.Column="1"
                                        Margin="6,0,0,0"
                                        Background="#F3F3F3"
                                        CornerRadius="6">

                                    <TextBlock Text="грн"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"/>

                                </Border>

                            </Grid>

                        </StackPanel> 
                    </Grid> 

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <Button Content="Скасувати"
                                Width="120"
                                Height="40"
                                Margin="0,0,10,0"
                                Style="{StaticResource ExitButton}"
                                Command="{Binding CloseOpenShiftDialogWindowCommand}"/>

                        <Button Content="Відкрити зміну"
                                Width="170"
                                Height="40"
                                Style="{StaticResource SuccessButton}" 
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Command="{Binding OpenShiftCommand}"/>

                    </StackPanel>

                </Grid>

            </Border>
        </Grid>
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding VisibilitiOpenShiftSuccessDialogWindow}" Panel.ZIndex="4">
            <Border Width="420"
                    Background="#FAFAFA"
                    CornerRadius="10"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    Padding="25">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
 
                    <StackPanel HorizontalAlignment="Center">
 
                        <Border Width="72"
                                Height="72"
                                Background="#27AE60"
                                CornerRadius="36"
                                Margin="0,0,0,20">

                            <Viewbox Margin="18">
                                <Path Stroke="White"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 2 10 L 8 16 L 18 4"/>
                            </Viewbox>

                        </Border>
 
                        <TextBlock Text="Зміну відкрито"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
 
                        <TextBlock Margin="0,12,0,0"
                                   Text="Робочу зміну успішно відкрито.&#10;Можна розпочинати роботу."
                                   TextAlignment="Center"
                                   Foreground="#666666"
                                   FontSize="15"/>

                    </StackPanel>
 
                    <Button Grid.Row="1"
                            Width="140"
                            Height="42"
                            Margin="0,25,0,0"
                            HorizontalAlignment="Center" 
                            Content="OK"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding CloseOpenShiftSuccessDialogWindowCommand}" /> 
                </Grid>

            </Border>
        </Grid>

        <Grid x:Name="InputBox" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="10" Panel.ZIndex="4" 
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Visibility="{Binding VisibilitiOfficialDepositMoneyDialogWindow , UpdateSourceTrigger=PropertyChanged}"> 
            
            <Border
                 Width="420"
                 Background="#FAFAFA"
                 CornerRadius="10"
                 BorderBrush="#D9D9D9"
                 BorderThickness="1"
                 Padding="25">
                <StackPanel> 
                    <TextBlock
                        Text="Сума внесених коштів"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"/> 
                    <TextBox
                        Margin="10"
                        x:Name="InputTextBox" 
                        Width="180"
                        TextAlignment="Right"
                        VerticalContentAlignment="Center" 
                        HorizontalAlignment="Center"
                        Style="{StaticResource GeneralTextBox}"
                        Text="{Binding Cash, StringFormat=0.00}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"> 
                        <Button
                            Margin="5"
                            Width="120"
                            Height="40" 
                            Content="Внести кошти" 
                            Command="{Binding OfficialDepositMoneyCommand}" 
                            Style="{StaticResource SuccessButton}" /> 
                        <Button
                             Margin="5"
                             Content="Відмінити"
                             Width="120"
                             Height="40" 
                             Command="{Binding CloseOfficialDepositMoneyDialogWindowCommad}"
                             Style="{StaticResource ExitButton}"   /> 
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding VisibilitiSuccessOfficialDepositMoneyDialogWindow}" Panel.ZIndex="4">
            <Border Width="420"
                    Background="#FAFAFA"
                    CornerRadius="10"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    Padding="25">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center">

                        <Border Width="72"
                                Height="72"
                                Background="#27AE60"
                                CornerRadius="36"
                                Margin="0,0,0,20">

                            <Viewbox Margin="18">
                                <Path Stroke="White"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 2 10 L 8 16 L 18 4"/>
                            </Viewbox>

                        </Border>

                        <TextBlock Text="Кошти успішно внесено"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <StackPanel>
                            <TextBlock Margin="0,12,0,0"
                                       Text="Сума внесення:"
                                       TextAlignment="Center"
                                       Foreground="#666666"
                                       FontSize="15"/>
                            <TextBlock Margin="10"  
                                       Foreground="#666666"
                                       TextAlignment="Right" 
                                       HorizontalAlignment="Center" 
                                       Text="{Binding Cash, StringFormat=0.00}"/>
                        </StackPanel>
                      

                    </StackPanel> 
                    <Button Grid.Row="1"
                            Width="140"
                            Height="42"
                            Margin="0,25,0,0"
                            HorizontalAlignment="Center" 
                            Content="OK"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding CloseSuccessOfficialDepositMoneyDialogWindowCommad}" />
                </Grid>

            </Border>
        </Grid>




        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="10" Panel.ZIndex="4" 
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Visibility="{Binding VisibilitiOfficialWithdrawalMoneyDialogWindow , UpdateSourceTrigger=PropertyChanged}">

            <Border Width="420"
                    Background="#FAFAFA"
                    CornerRadius="10"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    Padding="25">
                <StackPanel>
                    <TextBlock Text="Сума виданих коштів"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"
                               HorizontalAlignment="Center"/>
                    <TextBox Margin="10" 
                             Width="180"
                             TextAlignment="Right"
                             VerticalContentAlignment="Center" 
                             HorizontalAlignment="Center"
                             Style="{StaticResource GeneralTextBox}"
                             Text="{Binding Cash, StringFormat=0.00}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Margin="5"
                                Width="120"
                                Height="40" 
                                Content="Видати кошти" 
                                Command="{Binding OfficialWithdrawalMoneyCommand}" 
                                Style="{StaticResource SuccessButton}" />
                        <Button Margin="5"
                                Content="Відмінити"
                                Width="120"
                                Height="40" 
                                Command="{Binding CloseOfficialWithdrawalMoneyDialogWindowCommad}"
                                Style="{StaticResource ExitButton}"   />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding VisibilitiSuccessOfficialWithdrawalMoneyDialogWindow}" Panel.ZIndex="4">
            <Border Width="420"
                    Background="#FAFAFA"
                    CornerRadius="10"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    Padding="25">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center">

                        <Border Width="72"
                                Height="72"
                                Background="#27AE60"
                                CornerRadius="36"
                                Margin="0,0,0,20">

                            <Viewbox Margin="18">
                                <Path Stroke="White"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 2 10 L 8 16 L 18 4"/>
                            </Viewbox>

                        </Border>

                        <TextBlock Text="Кошти успішно видано"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <StackPanel>
                            <TextBlock Margin="0,12,0,0"
                                       Text="Сума виданих коштів:"
                                       TextAlignment="Center"
                                       Foreground="#666666"
                                       FontSize="15"/>
                            <TextBlock Margin="10"  
                                       Foreground="#666666"
                                       TextAlignment="Right" 
                                       HorizontalAlignment="Center" 
                                       Text="{Binding Cash, StringFormat=0.00}"/>
                        </StackPanel>


                    </StackPanel>
                    <Button Grid.Row="1"
                            Width="140"
                            Height="42"
                            Margin="0,25,0,0"
                            HorizontalAlignment="Center" 
                            Content="OK"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding CloseSuccessOfficialWithdrawalMoneyDialogWindowCommad}" />
                </Grid>

            </Border>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding VisibilitiCloseShiftDialogWindow}" Panel.ZIndex="4">
            <Border Background="#FAFAFA"
                    CornerRadius="10"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    Padding="20"
                    Width="560">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions> 
                    <StackPanel HorizontalAlignment="Center">

                        <Border Width="70"
                                Height="70"
                                Background="#F39C12"
                                CornerRadius="35">

                            <TextBlock Text="🔒"
                                       FontSize="32"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>

                        </Border>

                        <TextBlock Margin="0,15,0,0"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Text="Закриття зміни"/>

                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#777"
                                   Text="Перевірте інформацію перед закриттям."/>

                    </StackPanel> 

                    <StackPanel Grid.Row="2"> 

                        <Border Margin="0,0,0,10"
                                Background="White"
                                BorderBrush="#E5E5E5"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Касир"  Foreground="Gray"/>

                                <TextBlock Grid.Column="1"
                                           FontWeight="SemiBold"
                                           Text="{Binding UserName}"/> 
                            </Grid> 
                        </Border> 
                        <Border Margin="0,0,0,15"
                                Background="White"
                                BorderBrush="#E5E5E5"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"> 
                            <Grid> 
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition/> 
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Каса"
                                   Foreground="Gray"/> 
                                <TextBlock Grid.Column="1"
                                   FontWeight="SemiBold"
                                   Text="{Binding WorkingShiftStatus.OperationRecorder.Name}"/>

                            </Grid>

                        </Border>  
                        <Border Background="White"
                                BorderBrush="#E5E5E5"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="15">

                            <Grid> 
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Продажів"/>
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           FontWeight="SemiBold"
                                           Text="{Binding SalesCount}"/>

                                <TextBlock Grid.Row="1" Text="Сума продажів"/>

                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           FontWeight="SemiBold"
                                           Text="{Binding SalesAmount,StringFormat={}{0:N2} грн}"/>

                                <TextBlock Grid.Row="2" Text="Повернень"/>

                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           FontWeight="SemiBold"
                                           Text="{Binding RefundAmount,StringFormat={}{0:N2} грн}"/>

                                <Separator Grid.Row="3" Grid.ColumnSpan="2"/>

                                <TextBlock Grid.Row="4"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Готівка в касі"/>

                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#27AE60"
                                           HorizontalAlignment="Right"
                                           Text="{Binding CashAmount,StringFormat={}{0:N2} грн}"/>

                            </Grid>

                        </Border>

                    </StackPanel> 

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Width="120"
                                Height="40"
                                Margin="0,0,10,0"
                                Content="Скасувати"
                                Style="{StaticResource ExitButton}"
                                Command="{Binding CloseCloseShiftDialogWindowCommand}"/>

                        <Button Width="170"
                                Height="40"
                                Content="Закрити зміну" 
                                Style="{StaticResource SuccessButton}"
                                Command="{Binding CloseShiftCommand}"/>

                    </StackPanel>

                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding VisibilitiCloseShiftSuccessDialogWindow}" Panel.ZIndex="4">
            <Border Width="420"
                    Background="#FAFAFA"
                    CornerRadius="10"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    Padding="25">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center">

                        <Border Width="72"
                         Height="72"
                         Background="#27AE60"
                         CornerRadius="36"
                         Margin="0,0,0,20">

                            <Viewbox Margin="18">
                                <Path Stroke="White"
                               StrokeThickness="3"
                               StrokeStartLineCap="Round"
                               StrokeEndLineCap="Round"
                               Data="M 2 10 L 8 16 L 18 4"/>
                            </Viewbox>

                        </Border>

                        <TextBlock Text="Зміну закрито"
                            FontSize="24"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"/>

                        <TextBlock Margin="0,12,0,0"
                            Text="Робочу зміну успішно закрито."
                            TextAlignment="Center"
                            Foreground="#666666"
                            FontSize="15"/>

                    </StackPanel>

                    <Button Grid.Row="1"
                            Width="140"
                            Height="42"
                            Margin="0,25,0,0"
                            HorizontalAlignment="Center" 
                            Content="OK"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding CloseCloseShiftSuccessDialogWindowCommand}" />
                </Grid>

            </Border>
        </Grid>

    </Grid>
</Page>
