<Page x:Class="ShopProject.View.UserPage.PointOfSale.SaleMenu.SaleMenuView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShopProject.View.UserPage.PointOfSale.SaleMenu"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"  
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
   
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SaleMenuView">
    <Page.Resources> 
        <ResourceDictionary> 
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/ButtonStyle.xaml"/>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/TextBoxStyle.xaml"/>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/TextBlockstyle.xaml"/>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/ComboBoxStyle.xaml"/>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/DataGridStyle.xaml"/>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/ContextMenuStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary> 
    </Page.Resources> 
    <Grid x:Name="Grid" Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition  Height="*"></RowDefinition>
            <RowDefinition  Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Border CornerRadius="10" 
                BorderBrush="LightGray" 
                BorderThickness="1" 
                SnapsToDevicePixels="True" 
                ClipToBounds="True">

            <DataGrid x:Name="dataGrid" 
                  ItemsSource="{Binding OperationSaleInfo.Products, UpdateSourceTrigger=PropertyChanged}"
                  AutoGenerateColumns="False"
                  ColumnWidth="*"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  FontSize="16"
                  Margin="10"
                  RowHeight="40"  
                  Style="{StaticResource DataGrid}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeader}" 
                  RowStyle="{StaticResource DataGridRow}"
                  CellStyle="{StaticResource RectangleCellStyle}" >
                <DataGrid.Resources>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources> 
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Штрихкод" Binding="{Binding Product.Code}" Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0,20,0"></Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Назва товару" Binding="{Binding Product.NameProduct}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0,20,0"></Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn> 
                    <DataGridTextColumn Header="Одиниці" Binding="{Binding Product.Unit.NameUnit}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0,20,0"></Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Ціна" Binding="{Binding Product.Price}" Width="100"  >
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0,20,0"></Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn> 
                    <DataGridTemplateColumn Header="Кількість" Width="100"> 
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <xctk:IntegerUpDown Name="myUpDownControl" Height="40" Width="100" Value="{Binding Count , UpdateSourceTrigger=PropertyChanged , Mode=TwoWay}" BorderThickness="0.5,0,0,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="20"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="10" Background="White" BorderBrush="#DDD" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        Padding="15"
                        Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="8">

                        <StackPanel>

                            <TextBlock Text="Пошук товару"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>

                            <TextBlock Margin="0,12,0,4"
                                       Text="Штрихкод:"/>

                            <TextBox VerticalContentAlignment="Center"
                                     Style="{StaticResource GeneralTextBox}"
                                     Text="{Binding BarCodeSearch, UpdateSourceTrigger=PropertyChanged}" >
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="TextChanged">
                                        <i:InvokeCommandAction Command="{Binding SearchBarCodeCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                        </StackPanel>

                    </Border>
                    <Border 
                        Grid.Row="1"
                        Margin="0,0,0,8"
                        Padding="15"
                        Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="8"> 
                        <StackPanel>
                            <TextBlock Text="Оплата"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>
                            <TextBlock Margin="0,12,0,4" Text="Тип оплати:"/> 
                            <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Готівка" Style="{StaticResource GeneralButton}" Command="{Binding SetCashPaymetnMethod}" Margin="5" Height="25" Width="125"></Button>
                                    <Button Content="Карта" Style="{StaticResource GeneralButton}" Command="{Binding SetCardPaymentMethod}" Margin="5" Height="25" Width="125"></Button>
                                </StackPanel> 
                            </StackPanel>
                        </StackPanel>

                    </Border>
                    <ContentControl Grid.Row="2" Content="{Binding PaymentMenthod}"></ContentControl>
                    <Border 
                        Grid.Row="3"
                        Margin="0,0,0,8"
                        Padding="15"
                        Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        Visibility="{Binding VisibilitiCheckMenu}"
                        CornerRadius="8"> 
                        <StackPanel>
                            <TextBlock Text="Налаштування чека"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>
                                <StackPanel>
                                    <CheckBox Content="Друкувати чек" 
                                              IsChecked="{Binding OperationSaleInfo.DrawingCheck}" Margin="0,12,0,5"/>
                                    <CheckBox Content="Фіскальний чек" 
                                              IsChecked="{Binding OperationSaleInfo.IsFiscalCheck}"/>
                                   </StackPanel>
                            <Button Content="Очистити чек" VerticalAlignment="Top" Height="25" Width="125" HorizontalAlignment="Right"
                                    Command="{Binding ClearFieldDataGid}" 
                                    Style="{StaticResource GeneralButton}"/>
                        </StackPanel> 
                    </Border>
                    <Border 
                        Grid.Row="4"
                        Margin="0,0,0,8"
                        Padding="15"
                        Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        Visibility="{Binding VisibilitiCheckMenu}"
                        CornerRadius="8">
                        <StackPanel>
                            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Content="Оплатити" Command="{Binding PrintingCheckCommand}" 
                                        IsEnabled="{Binding IsEnableSendCheckButton}" Style="{StaticResource SuccessButton}"
                                        Width="120" Height="40"  FontWeight="Bold"/> 
                            </StackPanel> 
                        </StackPanel>
                    </Border> 
                </Grid>
                        
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
