<UserControl x:Class="ShopProject.View.UserPage.PointOfSale.SaleMenu.PaymentMethod.CashMethodView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ShopProject.View.UserPage.PointOfSale.SaleMenu.PaymentMethod"
             xmlns:converter="clr-namespace:ShopProject.Helpers.Converters"
             mc:Ignorable="d" >
    <UserControl.Resources>
        <ResourceDictionary>
            <converter:PercentageConverter x:Key="PercentageConverter"></converter:PercentageConverter>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/ButtonStyle.xaml"/>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/TextBoxStyle.xaml"/>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/TextBlockstyle.xaml"/>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/ComboBoxStyle.xaml"/> 
                <ResourceDictionary Source="/Resource/Theme/LightTheme/ContextMenuStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary> 
    </UserControl.Resources>
    <StackPanel>
        <Border
            Grid.Row="2"
            Margin="0,0,0,12"
            Padding="15"
            Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="8">

            <StackPanel>

                <TextBlock
                    Text="Підсумок"
                    FontSize="17"
                    FontWeight="SemiBold"/>
                <StackPanel Grid.Row="4" Margin="-3,5,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition> 
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Знижка :"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Height="28" Style="{StaticResource GeneralTextBox}" 
                                 Text="{Binding OperationSaleInfo.DiscountPrecent,Converter={StaticResource PercentageConverter}, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="15" Width="45" TextAlignment="Right" Margin="0,0,2,0"
                                 VerticalContentAlignment="Center"
                                 HorizontalAlignment="Left" Panel.ZIndex="10"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Height="28" Style="{StaticResource GeneralTextBox}"
                                 Text="{Binding OperationSaleInfo.Discount ,StringFormat='{}{0:0.00}',UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 FontSize="15" Width="145" TextAlignment="Right" Margin="0,0,2,0" HorizontalAlignment="Right"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Сума до оплати:"  FontWeight="SemiBold"/>
                        <Label Grid.Row="1" Grid.Column="1" Content="{Binding OperationSaleInfo.SumaOrder, StringFormat='{}{0:0.00}'}" 
                               FontSize="16" Foreground="#E53935" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,2,0"/>
                        <Label Grid.Row="2" Grid.Column="0" Content="Одержана сума:"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Height="28" Style="{StaticResource GeneralTextBox}"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding OperationSaleInfo.SumaUser, StringFormat='{}{0:0.00}'}"
                                 FontSize="15" Width="145" TextAlignment="Right" Margin="0,0,2,0" HorizontalAlignment="Right"/>

                    </Grid>

                </StackPanel>

            </StackPanel>

        </Border>
        <Border
            Grid.Row="3"
            Margin="0,0,0,12"
            Padding="15"
            Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="8">

            <StackPanel>

                <TextBlock
                    Text="Швидке внесення"
                    FontSize="17"
                    FontWeight="SemiBold"/>
                
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Stretch" >
                    <Button Grid.Column="3"  Content="1" VerticalAlignment="Top" Margin="2" Padding="2"  Width="55" HorizontalAlignment="Right"
                            Command="{Binding AddNumberToTextBoxCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Content}"
                            Style="{StaticResource GeneralButton}" />
                    <Button Grid.Column="3"  Content="2" VerticalAlignment="Top" Margin="2" Padding="2"  Width="55" HorizontalAlignment="Right"
                            Command="{Binding AddNumberToTextBoxCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Content}"
                            Style="{StaticResource GeneralButton}"/>
                    <Button Grid.Column="3"  Content="5" VerticalAlignment="Top" Margin="3" Padding="2"  Width="55" HorizontalAlignment="Right"
                            Command="{Binding AddNumberToTextBoxCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Content}"
                            Style="{StaticResource GeneralButton}"/>
                    <Button Grid.Column="3"  Content="10" VerticalAlignment="Top" Margin="2" Padding="2"  Width="55" HorizontalAlignment="Right"
                            Command="{Binding AddNumberToTextBoxCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Content}"
                             Style="{StaticResource GeneralButton}"/>
                    <Button Grid.Column="3"  Content="20" VerticalAlignment="Top" Margin="2" Padding="2"  Width="55" HorizontalAlignment="Center"
                            Command="{Binding AddNumberToTextBoxCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Content}"
                             Style="{StaticResource GeneralButton}"/>

                </StackPanel>
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Stretch">
                    <Button Grid.Column="3"  Content="50" VerticalAlignment="Bottom" Padding="2" Margin="2"  Width="55" HorizontalAlignment="Center"
                            Command="{Binding AddNumberToTextBoxCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Content}"
                            Style="{StaticResource GeneralButton}"/>
                    <Button Grid.Column="3"  Content="100" VerticalAlignment="Bottom" Padding="2" Margin="2"  Width="55" HorizontalAlignment="Right"
                            Command="{Binding AddNumberToTextBoxCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Content}"
                             Style="{StaticResource GeneralButton}"/>
                    <Button Grid.Column="3"  Content="200" VerticalAlignment="Bottom" Padding="2" Margin="3"  Width="55" HorizontalAlignment="Right"
                            Command="{Binding AddNumberToTextBoxCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Content}"
                             Style="{StaticResource GeneralButton}"/>
                    <Button Grid.Column="3"  Content="500" VerticalAlignment="Bottom" Padding="2" Margin="2"  Width="55" HorizontalAlignment="Right"
                            Command="{Binding AddNumberToTextBoxCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Content}"
                             Style="{StaticResource GeneralButton}"/>
                    <Button Grid.Column="3"  Content="1000" VerticalAlignment="Bottom" Padding="2" Margin="2" Width="55" HorizontalAlignment="Right"
                            Command="{Binding AddNumberToTextBoxCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Content}"
                             Style="{StaticResource GeneralButton}"/>
                </StackPanel>

            </StackPanel>

        </Border>
    </StackPanel>
</UserControl>
