<Window x:Class="ShopProject.View.Common.Main.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:ShopProject.View.Common.Main"
        xmlns:contextMenuHelper="clr-namespace:ShopProject.Helpers"
        mc:Ignorable="d"   
        WindowState="Maximized" 
        WindowStartupLocation="CenterScreen"
        Title="Project Shop" Height="550" Width="800" Icon="/Resource/Images/shop.png" WindowStyle="None">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome
               CaptionHeight="20"
               ResizeBorderThickness="6"
               GlassFrameThickness="0"
               CornerRadius="0"
               UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/ButtonStyle.xaml"/>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/ContextMenuStyle.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="#EEF1F5"> 
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="60"/> 
            <RowDefinition Height="*"/> 
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="140"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        <Border
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="#F1F3F7"
                shell:WindowChrome.IsHitTestVisibleInChrome="False"/>

        <Border Grid.Column="0"
                Grid.ColumnSpan="3"
                Background="#F1F3F7" 
                VerticalAlignment="Stretch"
                Grid.Row="0"
                shell:WindowChrome.IsHitTestVisibleInChrome="False" 
                BorderBrush="#E1E5EC"  
                BorderThickness="0,0,0,1"
                Grid.RowSpan="2">

            <StackPanel Margin="20,5,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Stretch"
                        shell:WindowChrome.IsHitTestVisibleInChrome="False"  >

                <Border Width="60"
                        Height="60"
                        CornerRadius="9"
                        Padding="4"
                        Background="CadetBlue"
                        VerticalAlignment="Center">
                    <Image Source="/Resource/Images/shop.png" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <StackPanel Margin="10,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Project Shop"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#20242A"/>

                    <TextBlock Text="Система керування"
                        FontSize="10"
                        Foreground="#8A9099"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" 
                Visibility="{Binding VisibilityMenu}"
                Grid.Column="1"
                Background="#F1F3F7"
                Margin="0,-15,0,0"
                BorderBrush="#E1E5EC"  
                BorderThickness="0,0,0,1">

            <Grid>

                <Grid.ColumnDefinitions>
 
                    <ColumnDefinition Width="Auto"/> 
                    <ColumnDefinition Width="*"/> 
                    <ColumnDefinition Width="Auto"/> 
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions> 

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="False"
                            Margin="10,8,0,0"
                            VerticalAlignment="Center">
 

                    <Button Style="{StaticResource TopMenuButton}" 
                            shell:WindowChrome.IsHitTestVisibleInChrome="False"
                            contextMenuHelper:ContextMenuHelper.OpenOnLeftClick="True"
                            IsEnabled="{Binding IsEnableMenuButton}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="⚙"
                                       FontSize="15"
                                       Margin="0,0,7,0"/>

                            <TextBlock Text="Програма"/>

                        </StackPanel>

                        <Button.ContextMenu>

                            <ContextMenu  Style="{StaticResource ModernContextMenuStyle}">

                                <MenuItem Header="⚙  Налаштування" 
                                          Style="{StaticResource ModernMenuItemStyle}"
                                          Command="{Binding OpenSettingCommand}"/>

                                <Separator/>

                                <MenuItem Header="🚪  Вийти"
                                          Style="{StaticResource ModernMenuItemStyle}"
                                          Command="{Binding ExitAppCommand}"/>

                            </ContextMenu>

                        </Button.ContextMenu>

                    </Button>

 

                    <Button Style="{StaticResource TopMenuButton}"
                            contextMenuHelper:ContextMenuHelper.OpenOnLeftClick="True"
                            IsEnabled="{Binding IsEnableMenuButton}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="☷"
                                       FontSize="17"
                                       Margin="0,0,7,0"/>

                            <TextBlock Text="Списки"/>

                        </StackPanel>

                        <Button.ContextMenu>

                            <ContextMenu Style="{StaticResource ModernContextMenuStyle}">

                                <MenuItem Header="Список товарів"
                                          Style="{StaticResource ModernMenuItemStyle}"
                                          Command="{Binding OpenStorageCommand}"/>

                                <Separator/>

                                <MenuItem Header="Користувачі"
                                          Style="{StaticResource ModernMenuItemStyle}"
                                          Command="{Binding OpenUsersCommand}"/>

                                <MenuItem Header="Об’єкти власності"
                                          Style="{StaticResource ModernMenuItemStyle}"
                                          Command="{Binding OpenPoinOfSalePageCommand}"/>

                            </ContextMenu>

                        </Button.ContextMenu>

                    </Button>

 

                    <Button Style="{StaticResource TopMenuButton}"
                            Command="{Binding OpenAssignedPointOfSaleCommand}"
                            IsEnabled="{Binding IsEnableMenuButton}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="🛍"
                                       FontSize="15"
                                       Margin="0,0,7,0"/>

                            <TextBlock Text="Продаж"/>

                        </StackPanel>

                    </Button>

 

                    <Button Style="{StaticResource TopMenuButton}"
                            contextMenuHelper:ContextMenuHelper.OpenOnLeftClick="True"
                            IsEnabled="{Binding IsEnableMenuButton}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="🧰"
                                       FontSize="15"
                                       Margin="0,0,7,0"/>

                            <TextBlock Text="Інструменти"/>

                        </StackPanel>

                        <Button.ContextMenu>

                            <ContextMenu Style="{StaticResource ModernContextMenuStyle}">

                                <MenuItem Header="Роздрукувати етикетку"
                                          Style="{StaticResource ModernMenuItemStyle}"
                                          Command="{Binding OpenCreateStikerCommnad}"/>

                            </ContextMenu>

                        </Button.ContextMenu>

                    </Button>

 

                    <!--<Button Style="{StaticResource TopMenuButton}"
                            Command="{Binding OpenStatisticsPageCommand}"
                            IsEnabled="{Binding IsEnableMenuButton}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="▥"
                                       FontSize="16"
                                       Margin="0,0,7,0"/>

                            <TextBlock Text="Статистика"/>

                        </StackPanel>

                    </Button>--> 
                </StackPanel> 
            </Grid>

        </Border>

        <Border  Grid.Column="1" 
                 Visibility="{Binding VisibilityMenu}"
                 Background="#F1F3F7"
                 Grid.ColumnSpan="2"
                 Grid.Row="1"
                 Height="60"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 BorderBrush="#E1E5EC"  
                 BorderThickness="0,0,0,1">
            
            <StackPanel Orientation="Horizontal" 
                        Margin="0,-15,0,0"  >


                <!-- ========================== -->
                <!-- CONNECTION STATUS          -->
                <!-- ========================== -->

                <Border Background="White"
                        BorderBrush="#E0E4EA"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="36"
                        Padding="9,0"
                        Margin="0,0,8,0">

                    <UserControl Content="{Binding StatusMenu}" />


                </Border>


                <!-- ========================== -->
                <!-- NOTIFICATION               -->
                <!-- ========================== -->

                <Button Style="{StaticResource HeaderIconButton}"
                 Command="{Binding OpenNotificationPanelCommand}"
                 ToolTip="Сповіщення">

                    <Grid>

                        <TextBlock Text="🔔"
                            FontSize="17"/>

                        <Border Background="CadetBlue"
                                Width="15"
                                Height="15"
                                CornerRadius="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="7,-5,-5,0">

                            <TextBlock Text="{Binding NotificationValue}"
                                Foreground="White"
                                FontSize="8"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Button>


                <!-- ========================== -->
                <!-- USER                       -->
                <!-- ========================== -->

                <Button Style="{StaticResource UserButton}"
                        Height="40"
                        contextMenuHelper:ContextMenuHelper.OpenOnLeftClick="True"
                        IsEnabled="{Binding IsEnableMenuButton}">

                    <StackPanel Orientation="Horizontal">

                        <Border Width="32"
                         Height="32"
                         CornerRadius="16"
                         Background="#DCE6F9">

                            <TextBlock Text="👤"
                                FontSize="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Margin="8,0,5,0"
                             VerticalAlignment="Center">

                            <TextBlock Text="{Binding UserName}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#30343A"/>

                            <TextBlock Text="Користувач"
                                FontSize="9"
                                Foreground="#8A9099"/>

                        </StackPanel>

                    </StackPanel>

                    <Button.ContextMenu>

                        <ContextMenu Style="{StaticResource ModernContextMenuStyle}">

                            <MenuItem Header="👤  Профіль"
                                      Style="{StaticResource ModernMenuItemStyle}"
                                      Command="{Binding OpenSettingCommand}"/>

                            <Separator/>

                            <MenuItem Header="🚪  Вийти"
                                      Style="{StaticResource ModernMenuItemStyle}"
                                      Command="{Binding ExitUserCommand}"/>

                        </ContextMenu>

                    </Button.ContextMenu>

                </Button>

            </StackPanel>
        </Border>



        <StackPanel Grid.Row="0"  
                    Grid.Column="2"
                    Background="#F1F3F7"
                    Orientation="Horizontal"> 
            <Button Style="{StaticResource WindowButton}"
                    Height="30"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" 
                    Click="MinimizeButton_Click"> 
                <TextBlock Text="─"
                    FontSize="16"/> 
            </Button> 
            <Button Style="{StaticResource WindowButton}"
                    Height="30"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="MaximizeButton_Click"> 
                <TextBlock Text="□"
                    FontSize="14"/> 
            </Button> 
            <Button Style="{StaticResource CloseWindowButton}"
                    Height="30"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CloseButton_Click"> 
                <TextBlock Text="×"
                    FontSize="16"/> 
            </Button> 
        </StackPanel>



        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"  shell:WindowChrome.IsHitTestVisibleInChrome="True">

            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right"
                    Width="450" 
                    Visibility="{Binding VisibilityNotification}"
                    Panel.ZIndex="2" >
                <UserControl Content="{Binding Notification}" Panel.ZIndex="3"></UserControl>
            </Border>
            <Border HorizontalAlignment="Stretch" Grid.Row="1" Margin="0" Panel.ZIndex="1">
                <Frame x:Name="frame" Grid.Row="1" 
                Visibility="{Binding PageVisibiliti}"
                Content="{Binding Path=Page, UpdateSourceTrigger=PropertyChanged}"
                NavigationUIVisibility="Hidden"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
            <Border HorizontalAlignment="Stretch" Grid.Row="1" Margin="0" Panel.ZIndex="2" Visibility="{Binding VisibilitiLostConnectionPage,UpdateSourceTrigger=PropertyChanged}">
                <Frame x:Name="frame1" Grid.Row="1"
                Content="{Binding Path=LostConnectionPage, UpdateSourceTrigger=PropertyChanged}"
                NavigationUIVisibility="Hidden"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>

        </Grid>
 
        <Rectangle x:Name="ShadowRect1"
                   Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   Grid.RowSpan="2"
                   Fill="Black"
                   Opacity="0.5"
                   Visibility="{Binding VisibilitiShadowPage}"
                   Panel.ZIndex="100"/>

    </Grid> 
</Window>
