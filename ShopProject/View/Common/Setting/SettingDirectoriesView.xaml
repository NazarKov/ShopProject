<Page x:Class="ShopProject.View.Common.Setting.SettingDirectoriesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShopProject.View.Common.Setting"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SettingDirectoriesView">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/ButtonStyle.xaml"/>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/ComboBoxStyle.xaml"/>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/TextBoxStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
        <Border Background="White"
                Padding="15"
                CornerRadius="6">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Налаштування списків"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#333"/>

                    <Separator Margin="0,10,0,15"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="White"
                        Padding="15"
                        CornerRadius="6"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/> 
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Налаштування складу"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#333"/>
                        <Separator Grid.ColumnSpan="2" Grid.Row="0" VerticalAlignment="Center" Margin="0,15,0,0"></Separator>


                        <Label x:Name="label2"
                               Content="Довжина штрихкоду товару" 
                               HorizontalAlignment="Left" 
                               Grid.Row="1"
                               VerticalAlignment="Center"/>
                        <TextBox x:Name="textBox" 
                                 Grid.Column="1"
                                 HorizontalAlignment="Right"
                                 Width="200"
                                 Height="30" 
                                 Grid.Row="1"
                                 Style="{StaticResource GeneralTextBox}"
                                 Text="{Binding ProductBarCodeLength}"
                                 VerticalAlignment="Center" />
                        <Separator Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Bottom" Margin="0,15,0,0"></Separator>

                        <!--<Label x:Name="label3" Content="Довжина штрихкоду сертифікату" HorizontalAlignment="Left" Grid.Row="1" Margin="0,15,0,15" VerticalAlignment="Top"/>
                        <TextBox x:Name="textBox3" Grid.Column="1" HorizontalAlignment="Stretch" Height="30" Margin="0,15,0,15"  Grid.Row="1" TextWrapping="Wrap" Text="{Binding SertificateBarCodeLength}" VerticalAlignment="Center" />-->


                        <Button x:Name="button" 
                                Width="200"
                                Height="34"
                                Grid.Column="1"
                                Grid.Row="2"
                                HorizontalAlignment="Right"
                                Command="{Binding SaveSettingCommand}" 
                                Style="{StaticResource StorageButton}"
                                Content="Зберегти налаштування" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
