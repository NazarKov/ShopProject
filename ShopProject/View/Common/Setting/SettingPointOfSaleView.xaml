<Page x:Class="ShopProject.View.Common.Setting.SettingPointOfSaleView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShopProject.View.Common.Setting"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SettingPointOfSaleView">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/ButtonStyle.xaml"/>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/ComboBoxStyle.xaml"/>
                <ResourceDictionary Source="/Resource/Theme/LightTheme/TextBoxStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
        <Border Background="White"
                Padding="15"
                CornerRadius="6">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Налаштування меню продаж"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#333"/>

                    <Separator Margin="0,10,0,15"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="White"
                        Padding="15"
                        CornerRadius="6"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/> 
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Налаштування Прро"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#333"/>
                        <Separator Grid.ColumnSpan="2" Grid.Row="0" VerticalAlignment="Center" Margin="0,15,0,0"></Separator>
                        <Label x:Name="label2" 
                               Content="Тестовий режим"
                               HorizontalAlignment="Left"
                               Grid.Row="1"  
                               VerticalAlignment="Center"/>
                        <CheckBox x:Name="checkBox" 
                                  Grid.Column="1"
                                  IsChecked="{Binding IsTestMode}"  
                                  HorizontalAlignment="Right" 
                                  Grid.Row="1"
                                  VerticalAlignment="Center"/>

                        <Label x:Name="label3"
                               Content="Штрихкод для видалення" 
                               HorizontalAlignment="Left"
                               Grid.Row="2" 
                               VerticalAlignment="Center"/>
                        <TextBox x:Name="textBox" 
                                 Width="200"
                                 Grid.Column="1"
                                 HorizontalAlignment="Right" 
                                 Grid.Row="2" 
                                 Height="30" 
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Right"
                                 Style="{StaticResource GeneralTextBox}"
                                 Text="{Binding DeleteBarCode}" 
                                 VerticalAlignment="Center"  />

                        <Separator Grid.ColumnSpan="2" Grid.Row="2" VerticalAlignment="Bottom" Margin="0,15,0,0"></Separator>
                        <Button x:Name="button"  
                                Width="200"
                                HorizontalAlignment="Right"
                                Grid.Column="1"
                                Grid.Row="3"
                                Command="{Binding SaveSettingCommand}" 
                                Height="34"
                                Content="Зберегти налаштування"
                                Style="{StaticResource StorageButton}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
