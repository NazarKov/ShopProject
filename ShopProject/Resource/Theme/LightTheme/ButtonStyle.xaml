                        <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                     Value="True">

                            <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="CadetBlue"/>

                        </Trigger>

                        <Trigger Property="IsPressed"
                                     Value="True">

                            <Setter TargetName="ButtonBorder"
                                        Property="Background"
